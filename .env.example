# Copy to .env (git-ignored) and fill in. The server reads it at start-up.
# Without any key the app runs in stub mode (rule-based, no AI calls).
GIGGUARD_LLM_MODE=live
GIGGUARD_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Or use Claude instead:
# GIGGUARD_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Optional overrides
# GIGGUARD_GEMINI_MODEL=gemini-3.8-flash
# GIGGUARD_MODEL=claude-opus-5-5
# GIGGUARD_FAST_MODEL=claude-haiku-4-5-20251001
